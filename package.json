{
 "name": "stickforge-3d",
 "version": "1.0.0",
 "description": "StickForge 3D animation studio",
 "author": "StickForge",
 "main": "main.js",
 "private": true,
 "scripts": {
  "start": "electron .",
  "win": "electron-builder --win --publish never"
 },
 "dependencies": {
  "@capacitor/android": "^6.1.0",
  "@capacitor/core": "^6.1.0"
 },
 "devDependencies": {
  "@capacitor/cli": "^6.1.0",
  "electron": "^31.0.0",
  "electron-builder": "^24.13.3"
 },
 "build": {
  "appId": "com.stickforge.studio",
  "productName": "StickForge 3D",
  "directories": {
   "output": "dist"
  },
  "files": [
   "main.js",
   "www/**/*"
  ],
  "win": {
   "target": [
    "portable",
    "nsis"
   ],
   "icon": "www/icons/icon-512.png"
  },
  "nsis": {
   "oneClick": false,
   "allowToChangeInstallationDirectory": true
  }
 }
}