name: Build apps
on:
  push:
    branches: [main]
  workflow_dispatch:
jobs:
  windows:
    runs-on: windows-latest
    defaults:
      run:
        shell: bash
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with: { node-version: 20 }
      - name: Prepare www
        run: |
          mkdir -p www/icons
          mv index.html manifest.webmanifest sw.js www/
          mv icon-192.png icon-512.png www/icons/
          curl -L -o www/three.min.js https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js
      - run: npm install
      - run: npm run win
      - uses: actions/upload-artifact@v4
        with: { name: StickForge-Windows, path: dist/*.exe }
  android:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with: { node-version: 20 }
      - uses: actions/setup-java@v4
        with: { distribution: temurin, java-version: 17 }
      - name: Prepare www
        run: |
          mkdir -p www/icons
          mv index.html manifest.webmanifest sw.js www/
          mv icon-192.png icon-512.png www/icons/
          curl -L -o www/three.min.js https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js
      - run: npm install
      - run: npx cap add android
      - run: npx cap sync android
      - run: cd android && chmod +x gradlew && ./gradlew assembleDebug
      - uses: actions/upload-artifact@v4
        with: { name: StickForge-Android, path: android/app/build/outputs/apk/debug/*.apk }
